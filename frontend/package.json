{
  "name": "bayanihandr-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BayanihanDR dashboard: local operations UI and public GitHub Pages demo",
  "scripts": {
    "dev": "vite",
    "dev:ops": "vite --mode ops",
    "build": "tsc -b && vite build",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:public": "playwright test -c playwright.public.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
